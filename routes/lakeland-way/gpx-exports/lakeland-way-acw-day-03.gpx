<gpx version="1.1" creator="route-planner"
  xmlns="http://www.topografix.com/GPX/1/1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Lakeland Way — Anticlockwise day 3 (2026-09-02)</name>
    <desc>Base 19.3km, +793m; with 6 detour(s): +6.6km, +763m ascent. Total 25.9km.</desc>
  </metadata>
  <wpt lat="54.376762" lon="-3.123790">
    <ele>796.0</ele>
    <name>Brim Fell 796m</name>
    <desc>A 796m grassy top on the ridge north of Coniston Old Man. Detour: +5.2km, +450m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.370486" lon="-3.122079">
    <ele>803.0</ele>
    <name>Coniston Old Man 803m</name>
    <desc>An 803m fell rising straight from the village, its flanks full of slate quarries and copper workings. Large summit cairn and a view to the sea. Detour: +5.0km, +507m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.370357" lon="-3.135929">
    <ele>778.0</ele>
    <name>Dow Crag 778m</name>
    <desc>A 778m summit perched above five great climbing buttresses dropping to Goats Water. The walk up is easy; the north face is not. Detour: +3.6km, +181m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.386757" lon="-3.205679">
    <ele>653.0</ele>
    <name>Harter Fell (Eskdale) 653m</name>
    <desc>A 653m fell of rocky tors above Eskdale, and one of the best-shaped small fells in the district. The true summit needs a short easy scramble. Detour: +2.9km, +400m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.374549" lon="-3.117781">
    <ele>546.0</ele>
    <name>Low Water</name>
    <desc>A shelf tarn at 546m directly below the summit of Coniston Old Man. Detour: +3.3km, +260m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.360667" lon="-3.136620">
    <ele>565.0</ele>
    <name>Blind Tarn</name>
    <desc>A true corrie tarn at 565m on Dow Crag with no inlet or outlet stream — it is fed entirely by the fell around it. Detour: +0.9km, +54m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.381255" lon="-3.110080">
    <name>Night 9 — camp</name>
    <type>camp</type>
  </wpt>
  <trk>
