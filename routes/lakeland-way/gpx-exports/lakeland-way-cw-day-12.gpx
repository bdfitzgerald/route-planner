  <wpt lat="54.361363" lon="-3.297380">
    <ele>234.0</ele>
    <name>Devoke Water</name>
    <desc>The largest tarn in the district at 234m, alone on Birker Fell with no fells immediately around it. Big skies, no shelter, rarely anyone there. Detour: +3.3km, +0m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
