<?xml version="1.0" encoding="UTF-8"?>
<gpx version="1.1" creator="route-planner"
  xmlns="http://www.topografix.com/GPX/1/1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.topografix.com/GPX/1/1 http://www.topografix.com/GPX/1/1/gpx.xsd">
  <metadata>
    <name>Lakeland Way — Anticlockwise day 11 (2026-09-10)</name>
    <desc>Base 12.8km, +420m; with 8 detour(s): +16.5km, +1384m ascent. Total 29.3km.</desc>
  </metadata>
  <wpt lat="54.432701" lon="-3.282570">
    <ele>609.0</ele>
    <name>Illgill Head 609m</name>
    <desc>A 609m fell forming the top of the Wast Water Screes, which fall 500m straight into the deepest lake in England. Grassy and gentle from behind, spectacular at the edge. Detour: +4.4km, +325m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.454098" lon="-3.212285">
    <ele>978.0</ele>
    <name>Scafell Pike 978m</name>
    <desc>England&apos;s highest ground at 978m. A boulder-strewn summit plateau with a huge cairn; cairned throughout but genuinely serious in mist, where the plateau defeats casual navigation. Usual approach from the route is via Lingmell Col. Detour: +5.9km, +474m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.466099" lon="-3.180239">
    <ele>785.0</ele>
    <name>Allen Crags 785m</name>
    <desc>A 785m top on the Esk Hause crossing, an easy addition to a Scafell day. Detour: +0.6km, +52m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.447366" lon="-3.165820">
    <ele>902.0</ele>
    <name>Bowfell 902m</name>
    <desc>A 902m pyramid at the head of Langdale with a genuinely rocky top and the Great Slab on its flank. The Band gives a long but never technical ascent. Detour: +3.1km, +336m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.428301" lon="-3.259506">
    <ele>254.0</ele>
    <name>Burnmoor Tarn</name>
    <desc>A wide shallow tarn on the moor between Eskdale and Wasdale at 254m. Peaty and comparatively mild; the surrounding ground is boggy, so use the firmer northern shore. Detour: +0.0km, +0m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.472261" lon="-3.219753">
    <ele>217.0</ele>
    <name>Emerald Pools</name>
    <desc>Green-tinted pools in the bed of Lingmell Beck below Wasdale Head, where the water has cut into clean rock. Cold and clear; easy entry from the shingle. Detour: +2.6km, +163m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.478084" lon="-3.202674">
    <ele>440.0</ele>
    <name>Styhead Tarn</name>
    <desc>Beneath Great Gable at 440m, right on the pass. Popular by day, quiet at either end of it. Mountain rescue stretcher box nearby. Detour: +1.4km, +49m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.458658" lon="-3.167308">
    <ele>557.0</ele>
    <name>Angle Tarn</name>
    <desc>Sitting at 557m under Bowfell and Rossett Pike, dark and deep with a boulder shore. Reached directly by the route over Rossett Gill. Detour: +0.0km, +0m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.422524" lon="-3.256495">
    <name>Night 1 — camp</name>
    <type>camp</type>
  </wpt>
  <trk>
    <name>Day 11</name>
