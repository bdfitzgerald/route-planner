      <trkpt lat="54.352403" lon="-3.385732"><ele>101.0</ele></trkpt>
      <trkpt lat="54.353390" lon="-3.384778"><ele>95.0</ele></trkpt>
      <trkpt lat="54.353664" lon="-3.384337"><ele>93.0</ele></trkpt>
      <trkpt lat="54.354458" lon="-3.383838"><ele>84.0</ele></trkpt>
      <trkpt lat="54.355280" lon="-3.383018"><ele>67.0</ele></trkpt>
      <trkpt lat="54.355641" lon="-3.381571"><ele>56.0</ele></trkpt>
      <trkpt lat="54.355978" lon="-3.381046"><ele>58.0</ele></trkpt>
      <trkpt lat="54.356357" lon="-3.380683"><ele>60.0</ele></trkpt>
      <trkpt lat="54.357612" lon="-3.381423"><ele>72.0</ele></trkpt>
      <trkpt lat="54.357884" lon="-3.383385"><ele>77.0</ele></trkpt>
      <trkpt lat="54.358650" lon="-3.385804"><ele>87.0</ele></trkpt>
      <trkpt lat="54.358742" lon="-3.385925"><ele>85.0</ele></trkpt>
      <trkpt lat="54.359709" lon="-3.384487"><ele>104.0</ele></trkpt>
      <trkpt lat="54.360350" lon="-3.383683"><ele>106.0</ele></trkpt>
      <trkpt lat="54.365035" lon="-3.378422"><ele>161.0</ele></trkpt>
      <trkpt lat="54.365349" lon="-3.377746"><ele>161.0</ele></trkpt>
      <trkpt lat="54.365538" lon="-3.377591"><ele>159.0</ele></trkpt>
      <trkpt lat="54.365763" lon="-3.377566"><ele>161.0</ele></trkpt>
      <trkpt lat="54.366066" lon="-3.377909"><ele>166.0</ele></trkpt>
      <trkpt lat="54.366235" lon="-3.377861"><ele>165.0</ele></trkpt>
