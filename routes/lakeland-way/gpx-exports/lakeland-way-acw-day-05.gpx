  <metadata>
    <name>Lakeland Way — Anticlockwise day 5 (2026-09-04)</name>
    <desc>Base 23.6km, +944m; with 4 detour(s): +4.8km, +352m ascent. Total 28.4km.</desc>
  </metadata>
  <wpt lat="54.482153" lon="-2.878177">
    <ele>784.0</ele>
    <name>Thornthwaite Crag 784m</name>
    <desc>A 784m top marked by a 4m stone beacon, at the junction of several ridges. Detour: +0.8km, +0m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.468708" lon="-2.873260">
    <ele>720.0</ele>
    <name>Froswick 720m</name>
    <desc>A 720m cone on the Kentmere horseshoe, a smaller echo of Ill Bell. Detour: +1.2km, +104m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.450290" lon="-3.042519">
    <ele>395.0</ele>
    <name>Silver How 395m</name>
    <desc>A 395m top above Grasmere with a fine view of the vale and the Langdale Pikes. Detour: +2.2km, +213m ascent.</desc>
    <type>peaks</type>
  </wpt>
  <wpt lat="54.452227" lon="-2.979696">
    <ele>146.0</ele>
    <name>High Fall</name>
    <desc>A fall in the Rydal Beck valley behind Rydal Hall. Detour: +0.7km, +35m ascent.</desc>
    <type>wild-swim-spots</type>
  </wpt>
  <wpt lat="54.481241" lon="-2.873929">
    <name>Night 7 — camp</name>
    <type>camp</type>
  </wpt>
