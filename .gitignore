.DS_Store
node_modules/
*.log

# Generated site data is committed on purpose (Netlify serves it statically),
# so site/route-data.json and routes/*/gpx-exports/ are NOT ignored.

dist/

# Credentials. site/config.js is generated by the build from OS_MAPS_KEY and is
# included in the packaged zip, so the deployed site has the key while the
# repository never does.
.env
site/config.js

# Netlify CLI link state (site id, local only)
.netlify/
