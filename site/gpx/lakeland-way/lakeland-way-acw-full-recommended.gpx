      <trkpt lat="54.370483" lon="-3.370528"><ele>184.0</ele></trkpt>
      <trkpt lat="54.370594" lon="-3.370390"><ele>185.3</ele></trkpt>
      <trkpt lat="54.370826" lon="-3.369921"><ele>187.8</ele></trkpt>
      <trkpt lat="54.371520" lon="-3.369256"><ele>200.3</ele></trkpt>
